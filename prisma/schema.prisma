generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model lancamentos {
  codigo                  String    @id
  nome                    String
  data_inicio             DateTime?
  data_fim                DateTime?
  status                  String?
  meta_faturamento        Float?
  observacoes             String?
  data_abertura_carrinho  DateTime?

  checklist_tarefas    checklist_tarefa[]
  links_config         lancamento_links_config?
  links                lancamento_link[]
}

model lancamento_links_config {
  id_lancamento      String  @id
  url_base_inscricao String?
  url_base_vendas    String?
  utm_id             String?

  lancamento lancamentos @relation(fields: [id_lancamento], references: [codigo])
}

model lancamento_link {
  id            String    @id @default(cuid())
  id_lancamento String
  categoria     String
  nome          String
  url           String?
  data_exibicao DateTime?
  ordem         Int       @default(0)
  criado_em     DateTime  @default(now())
  atualizado_em DateTime  @updatedAt

  lancamento lancamentos @relation(fields: [id_lancamento], references: [codigo])

  @@index([id_lancamento, categoria, ordem])
}

model automacao {
  id                String    @id @default(cuid())
  nome              String
  descricao         String?
  intervalo_minutos Int       @default(60)
  ultimo_ping       DateTime?
  ativo             Boolean   @default(true)
  criado_em         DateTime  @default(now())
  atualizado_em     DateTime  @updatedAt
}

model checklist_tarefa {
  id             String    @id @default(cuid())
  id_lancamento  String
  semana         Int
  ordem          Int
  tarefa         String
  local          String?
  responsavel    String?
  links          String?
  observacoes    String?
  offset_dias    Int?
  feito          Boolean   @default(false)
  data_conclusao DateTime?
  criado_em      DateTime  @default(now())
  atualizado_em  DateTime  @updatedAt

  lancamento lancamentos @relation(fields: [id_lancamento], references: [codigo])

  @@index([id_lancamento, semana, ordem])
}

model trafego_meta {
  unique_key       String   @id
  id_lancamento    String?
  data             DateTime?
  campanha         String?
  conjunto_anuncio String?
  anuncio          String?
  impressoes       Int?
  cliques_no_link  Int?
  cpc              Float?
  cpm              Float?
  ctr              Float?
  total_gasto      Float?
  leads            Int?
  thruplays            Int?
  custo_thruplay       Float?
  video_plays_3s       Int?
  custo_video_play_3s  Float?
  video_p25            Int?
  video_p50            Int?
  video_p75            Int?
  video_p95            Int?
  video_p100           Int?
  video_plays          Int?
  custo_vv25           Float?
  custo_vv50           Float?
  custo_vv75           Float?
  custo_vv95           Float?
  hook_rate            Float?
  retencao_25_75       Float?
}

model publicos_meta {
  unique_key    String    @id
  id_lancamento String?
  data          DateTime?
  publico_id    String?
  publico_nome  String?
  tamanho_min   Int?
  tamanho_max   Int?
  semelhante    Boolean?  @default(false)
  capturado_em  DateTime?
}

model leads {
  email              String
  id_lancamento      String
  hotmart_id         String?
  nome               String?
  telefone           String?
  utm_source         String?
  utm_medium         String?
  utm_campaign       String?
  utm_content        String?
  utm_term           String?
  virou_comprador    Boolean?  @default(false)
  respondeu_avatar   Boolean?  @default(false)

  @@id([email, id_lancamento])
}

model avatar {
  email                    String
  id_lancamento            String
  formacao_universitaria   String?
  maior_titulacao          String?
  experiencia_profissional String?
  anos_experiencia         String?
  sexo                     String?
  idade                    Int?
  estado                   String?
  tempo_conhece_claudio    String?
  mais_atrativo            String?
  renda_familiar           String?
  pergunta_ao_claudio      String?
  desejos_desafios         String?
  possui_filhos            String?
  utm_source               String?
  utm_medium               String?
  utm_campaign             String?

  @@id([email, id_lancamento])
}

model compradores {
  email               String
  id_lancamento       String
  hotmart_transaction String?
  nome                String?
  telefone            String?
  produto             String?
  valor_bruto         Float?
  valor_liquido       Float?
  metodo_pagamento    String?
  status_pagamento    String?
  utm_source          String?
  utm_medium          String?
  utm_campaign        String?
  data_compra         DateTime?

  @@id([email, id_lancamento])
}
